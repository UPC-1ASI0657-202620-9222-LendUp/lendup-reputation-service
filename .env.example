ENVIRONMENT=development
API_PORT=8082
LOG_LEVEL=INFO
DATABASE_URL=mysql+pymysql://lendup:change-me@mysql:3306/lendup_reputacion?charset=utf8mb4
FIREBASE_PROJECT_ID=lendup-3cb42
FIREBASE_CHECK_REVOKED=true
REQUIRE_VERIFIED_EMAIL=true
# Confirmed monolith contract; point to the deployed Identity service/gateway.
IDENTITY_BASE_URL=
IDENTITY_ME_PATH=/api/v1/estudiantes/me
IDENTITY_TIMEOUT_SECONDS=3
RABBITMQ_URL=amqp://lendup:change-me@rabbitmq:5672/%2F
# Provisional local names: validate with the Loans owner before production.
RABBITMQ_EXCHANGE=lendup.events
RABBITMQ_LOAN_QUEUE=lendup.reputation.loan-finalized.v1
RABBITMQ_LOAN_ROUTING_KEY=loans.loan-finalized.v1
RABBITMQ_RATING_ROUTING_KEY=reputation.rating-registered.v1
RABBITMQ_DLQ=lendup.reputation.loan-finalized.v1.dlq
LOAN_SUBSCRIPTION_ENABLED=false
OUTBOX_PUBLISHER_ENABLED=false
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_SECONDS=2
CORS_ORIGINS=["http://localhost:5173"]
DOCS_ENABLED=true
